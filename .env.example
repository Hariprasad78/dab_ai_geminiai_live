# Vertex AI / Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VERTEX_LIVE_MODEL=gemini-3.1-flash-live-preview
YTS_LIVE_VISUAL_MONITOR_INTERVAL_SECONDS=5.0

# LiveKit
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
ENABLE_LIVEKIT_AGENT=false

# DAB (Device Automation Bus)
# Set to "false" to connect to a real MQTT broker
DAB_MOCK_MODE=false
DAB_MQTT_BROKER=localhost
DAB_MQTT_PORT=1883
DAB_DEVICE_ID=adt-4
DAB_REQUEST_TIMEOUT=2
DAB_MAX_RETRIES=3
DAB_KEYPRESS_TIMEOUT=0.35
DAB_KEYPRESS_MAX_RETRIES=0
MANUAL_KEYPRESS_DEDUPE_WINDOW_MS=80
IR_SERIAL_PORT=
IR_SERIAL_BAUDRATE=115200
IR_SERIAL_TIMEOUT_SECONDS=3.0
IR_SAMSUNG_SENDER_CHANNEL=D2

# Unified active device contexts
# The app reads camera_devices.json by default. Use these optional per-context
# overrides for machine-local video/audio nodes without editing the checked-in map.
# Prefix = contextId uppercased, e.g. adt4 -> ADT4, sony -> SONY, samsung -> SAMSUNG.
CAMERA_DEVICES_CONFIG=./camera_devices.json

# Optional: recover a selected camera when a stale lower-priority process keeps
# the exact /dev/video* node busy. Priority policy kills only holders with a
# lower priority than CAMERA_DEVICE_OWNER_PRIORITY.
FORCE_KILL_CAMERA_HOLDERS=false
CAMERA_BUSY_RECOVERY_POLICY=priority
CAMERA_BUSY_QUARANTINE_SECONDS=30.0
CAMERA_DEVICE_OWNER_PRIORITY=80
CAMERA_UNKNOWN_HOLDER_PRIORITY=80
CAMERA_HOLDER_PRIORITIES=ffmpeg=10,python=40,python3=40
ADT4_VIDEO_SOURCE=hdmi-capture
ADT4_VIDEO_PATH=/dev/adt4_hdmi
ADT4_YTS_DEVICE_ID=42
ADT4_AUDIO_DEVICE=hw:3,0
SONY_VIDEO_SOURCE=camera-capture
SONY_VIDEO_PATH=/dev/v4l/by-id/usb-046d_081b_CE135500-video-index0
SONY_YTS_DEVICE_ID=e9
SONY_AUDIO_DEVICE=hw:4,0
SAMSUNG_VIDEO_SOURCE=camera-capture
SAMSUNG_VIDEO_PATH=/dev/v4l/by-id/usb-EBP6415700137706NL_LG_Smart_Cam_01.00.00-video-index0
SAMSUNG_YTS_DEVICE_ID=39
SAMSUNG_AUDIO_DEVICE=hw:5,0

# Session
SESSION_TIMEOUT_SECONDS=300
MAX_STEPS_PER_RUN=50

# Artifacts
ARTIFACTS_BASE_DIR=./artifacts

# API Server
API_HOST=0.0.0.0
API_PORT=8000
# Raspberry Pi recommended mode: run hardware/API only on the Pi and host UI
# from another server/laptop/GCP bucket. Set CORS to the frontend origin(s).
# You can also pass this at runtime:
#   python -m vertex_live_dab_agent --api-only --host 0.0.0.0 --port 8081
SERVE_FRONTEND=false
CORS_ALLOW_ORIGINS=http://localhost:5173,http://YOUR_BUCKET.storage.googleapis.com,https://YOUR_UI_DOMAIN

# Logging (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Multi-camera FastAPI preview service
# Format: device_id|kind|locator[|required-or-optional];...
# locator supports:
#   /dev/videoN
#   by-id:/dev/v4l/by-id/<stable-symlink>
#   usb:<substring-from-/dev/v4l/by-id>
MULTI_CAMERA_DEVICES=cam1|camera|by-id:/dev/v4l/by-id/usb-Logitech_C920-video-index0;cam2|camera|by-id:/dev/v4l/by-id/usb-Logitech_C922-video-index0;hdmi|hdmi|usb:elgato
MULTI_CAMERA_HOST=0.0.0.0
MULTI_CAMERA_PORT=8090
MULTI_CAMERA_LOG_LEVEL=INFO
MULTI_CAMERA_WIDTH=1280
MULTI_CAMERA_HEIGHT=720
MULTI_CAMERA_FPS=30.0
MULTI_CAMERA_JPEG_QUALITY=85
MULTI_CAMERA_FOURCC=MJPG
MULTI_CAMERA_RECONNECT_SECONDS=2.0
MULTI_CAMERA_STARTUP_TIMEOUT_SECONDS=8.0
MULTI_CAMERA_OPEN_RETRIES=4
MULTI_CAMERA_OPEN_RETRY_DELAY_SECONDS=0.6
MULTI_CAMERA_STALE_FRAME_SECONDS=5.0
MULTI_CAMERA_MONITOR_INTERVAL_SECONDS=2.0

# WebRTC camera preview service
# Format: device_id|kind|locator[|required-or-optional];...
# locator supports:
#   /dev/videoN
#   by-id:/dev/v4l/by-id/<stable-symlink>
#   usb:<substring-from-/dev/v4l/by-id>
#   auto:camera1 / auto:camera2 / auto:hdmi
WEBRTC_CAMERA_DEVICES=cam1|camera|auto:camera1|optional;cam2|camera|auto:camera2|optional;hdmi|hdmi|auto:hdmi|optional
WEBRTC_CAMERA_HOST=0.0.0.0
WEBRTC_CAMERA_PORT=8080
WEBRTC_CAMERA_LOG_LEVEL=INFO
WEBRTC_CAMERA_WIDTH=1280
WEBRTC_CAMERA_HEIGHT=720
WEBRTC_CAMERA_FPS=30.0
WEBRTC_CAMERA_FOURCC=MJPG
WEBRTC_CAMERA_OPEN_RETRIES=4
WEBRTC_CAMERA_OPEN_RETRY_DELAY_SECONDS=0.5
WEBRTC_CAMERA_RECONNECT_SECONDS=2.0
WEBRTC_CAMERA_FRAME_TIMEOUT_SECONDS=5.0
WEBRTC_CAMERA_STARTUP_TIMEOUT_SECONDS=8.0
WEBRTC_CAMERA_STATUS_INTERVAL_SECONDS=1.0
WEBRTC_CAMERA_STUN_URLS=stun:stun.l.google.com:19302
